# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=helpdesk
MONGODB_URI=mongodb://admin:password123@mongodb:27017/helpdesk?authSource=admin

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for helpdesk notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Milvus Configuration
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=rasa
MILVUS_PASSWORD=rasa@123
MILVUS_COLLECTION=test

# MinIO Configuration (for Milvus)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Application URLs (for frontend services)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
NEXT_PUBLIC_RASA_URL=http://localhost:5005
NEXT_PUBLIC_MILVUS_API_URL=http://localhost:3002

# Service Ports
HELPDESK_BACKEND_PORT=5000
