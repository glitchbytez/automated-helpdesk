# ===========================================
# CHATBOT DATA SERVICE CONFIGURATION
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=5502

# Milvus Database Configuration
MILVUS_HOST=milvus
MILVUS_PORT=19530
COLLECTION_NAME=chatbot_documents

# Collection Management
FORCE_RECREATE_COLLECTION=false

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=text-embedding-3-small

# ===========================================
# DOCKER DEPLOYMENT NOTES:
# ===========================================
# 
# 1. Copy this file to .env: cp .env.example .env
# 2. Update OPENAI_API_KEY with your actual key
# 3. For Docker: MILVUS_HOST=milvus (default)
# 4. For local dev: MILVUS_HOST=localhost  
# 5. Run: docker-compose up -d
#
# ===========================================
