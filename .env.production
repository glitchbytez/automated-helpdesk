# =================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Consolidated from existing subdirectory .env files
# =================================================================

# =================================================================
# APPLICATION ENVIRONMENT
# =================================================================
NODE_ENV=production

# =================================================================
# SERVER CONFIGURATION
# =================================================================

# Helpdesk Backend (from helpdesk-backend/.env.production.local)
PORT=5500

# Chatbot Data Service (inferred from usage)
CHATBOT_DATA_SERVICE_PORT=5502

# Chatbot Server (inferred from usage)  
CHATBOT_SERVER_PORT=5501

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# MongoDB (from helpdesk-backend/.env.production.local)
MONGODB_URI=mongodb://localhost:27017/helpdesk

# For Docker containers (MongoDB with auth)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=helpdesk

# Milvus Vector Database (inferred from code usage)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=rasa
MILVUS_PASSWORD=rasa@123
COLLECTION_NAME=test
FORCE_RECREATE_COLLECTION=false

# MinIO (for Milvus)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================

# JWT Configuration (from helpdesk-backend/.env.production.local)
JWT_SECRET=secret_token
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=1
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# API Key for internal services (from helpdesk-backend/.env.production.local)
API_KEY_SECRET=chatbot_server_api_key_12345

# =================================================================
# EMAIL CONFIGURATION
# =================================================================

# Email Settings (from helpdesk-backend/.env.production.local)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=timblaron5@gmail.com
EMAIL_PASSWORD=bawkyuzdbkwytzyw
EMAIL_FROM=timblaron5@gmail.com
EMAIL_FROM_NAME=Campus Support

# =================================================================
# FILE STORAGE
# =================================================================

# Local Storage (from helpdesk-backend/.env.production.local)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 Configuration (commented out from original)
# AWS_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# =================================================================
# FRONTEND CONFIGURATION
# =================================================================

# Next.js Public Variables (from helpdesk-frontend/.env)
NEXT_PUBLIC_API_URL=http://localhost:5500/api/v1
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:5501
NEXT_PUBLIC_MILVUS_API_URL=http://localhost:5502/api

# Frontend URL (used by backend for email links)
FRONTEND_URL=http://localhost:3001

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# =================================================================
# INTERNAL SERVICE COMMUNICATION
# =================================================================

# Backend API URL (from chatbot-server code)
BACKEND_API_URL=http://localhost:5500/api/v1

# For Docker container communication
HELPDESK_API_URL=http://helpdesk-backend:5500

